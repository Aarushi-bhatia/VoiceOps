# ---- Core ----
VOICEOPS_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ---- Database ----
# Postgres (docker compose default). Leave unset to fall back to local SQLite.
DATABASE_URL=postgresql+asyncpg://voiceops:voiceops@postgres:5432/voiceops

# ---- Redis ----
# Leave unset to fall back to the in-process Redis stub (single-process only).
REDIS_URL=redis://redis:6379/0

# ---- Worker ----
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=250
QUEUE_LEASE_SECONDS=120

# ---- Admission control ----
# Reject new calls once this many are waiting. 0 disables.
MAX_QUEUE_DEPTH=50000
# Drop calls queued longer ago than this rather than placing them late.
MAX_CALL_AGE_SECONDS=21600
# Carrier rate limit per outbound number. 0 disables; set it in production.
CARRIER_CALLS_PER_SECOND=0
CARRIER_BURST=5
# Outbound calling window in the callee's local time. start == end disables.
# Set this before calling real people; leaving it off is a legal risk.
CALLING_HOURS_START=0
CALLING_HOURS_END=0
CALLING_HOURS_TIMEZONE=UTC
# Delete finished calls, and their transcripts, after this many days. 0 keeps all.
RETENTION_DAYS=90

# ---- Authentication ----
# "<key>:<role>,<key>:<role>" with roles viewer/operator/admin.
# Empty disables auth entirely; /health reports which.
API_KEYS=

# ---- Retry policy ----
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_SECONDS=15
RETRY_MAX_DELAY_SECONDS=3600
RETRY_BACKOFF_MULTIPLIER=2.0
RETRY_JITTER_RATIO=0.2

# ---- Providers ----
# Each defaults to "mock" so the whole pipeline runs with no credentials.
STT_PROVIDER=mock          # mock | deepgram
LLM_PROVIDER=mock          # mock | anthropic
TTS_PROVIDER=mock          # mock | elevenlabs
TELEPHONY_PROVIDER=mock    # mock | twilio | telnyx | any module listed in TELEPHONY_PLUGINS

DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ELEVENLABS_API_KEY=

# ---- Telephony ----
# Each carrier reads its own prefixed variables, so switching carrier is only
# TELEPHONY_PROVIDER plus that carrier's block below.
#
# Spend guard, applied to every real carrier. Set both on a trial or demo account:
# numbers outside the allowlist are refused, and calls are cut off at the limit.
TELEPHONY_ALLOWED_NUMBERS=       # comma-separated, e.g. +15551230000,+15551230001
TELEPHONY_MAX_CALL_SECONDS=0     # 0 = no limit
# Extra provider modules to import at startup, comma-separated.
TELEPHONY_PLUGINS=

# Telnyx (TELEPHONY_PROVIDER=telnyx). TELNYX_CONNECTION_ID is the id of a Voice
# API (Call Control) application.
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM_NUMBER=
# Public origin the carrier can reach for media streams, e.g. https://abc.ngrok.app
TELNYX_PUBLIC_BASE_URL=

# Twilio (TELEPHONY_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_PUBLIC_BASE_URL=

# ---- Dashboard ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Gemini (alternative LLM provider) ----
# LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
